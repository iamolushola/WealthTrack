{
  "name": "@wealthtrack/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && concurrently -k -n build,worker -c cyan,yellow \"npm run dev:build\" \"npm run dev:start\"",
    "dev:build": "tsc -w -p tsconfig.json --preserveWatchOutput",
    "dev:start": "tsx watch dist/main.js",
    "start": "tsx dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "bullmq": "^5.16.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.6.3"
  }
}
